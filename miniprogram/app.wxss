/* Obsidian Focus 独立配色令牌（用户已确认） */
page {
  --bg: #131313;
  --surface: #1A1A1A;
  --stroke: #2A2A2A;
  --accent: #00F2FF;
  --ok: #00E676;
  --err: #FF1744;
  --text: rgba(255, 255, 255, 0.92);
  --muted: rgba(255, 255, 255, 0.65);
  --ghost: #8A8E94;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
}

/* 微信原生按钮重置与暗色适配 */
button {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-weight: normal;
  font-size: 28rpx;
  line-height: normal;
  background: none;
  border-radius: 0;
  color: inherit;
}
button:not([size='mini']) {
  width: auto;
  margin-left: 0;
  margin-right: 0;
}
button::after {
  display: none;
  border: none;
}
button[disabled] {
  color: rgba(255, 255, 255, 0.35) !important;
  background: rgba(255, 255, 255, 0.03) !important;
  border-color: rgba(255, 255, 255, 0.08) !important;
  opacity: 1 !important;
}

.card {
  background: var(--surface);
  border: 2rpx solid var(--stroke);
  border-radius: 16rpx;
}
.mono {
  font-family: "JetBrains Mono", "SF Mono", Menlo, Consolas, monospace;
}
.accent { color: var(--accent); }
.ok { color: var(--ok); }
.err { color: var(--err); }
.ghost { color: var(--ghost); }
