/* 自绘键盘：rpx 自适应（键高 88rpx / 间隙 8rpx / 容器上限 820rpx） */
.kb {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  max-width: 820rpx;
  margin: 0 auto;
  padding: 8rpx;
  box-sizing: border-box;
}
.kbrow {
  display: flex;
  gap: 8rpx;
  width: 100%;
  justify-content: center;
}
.key {
  flex: 1;
  min-width: 0;
  min-height: 44px;
  height: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--surface);
  border: 2rpx solid var(--stroke);
  border-radius: 8rpx;
  transition: transform 60ms, border-color 80ms, background 80ms;
}
.kbrow.wide .key { height: 76rpx; min-height: 44px; } /* 41 键大行保留 44px 触控高度 */
.key.special { flex: 1.6; }
.key .sm { font-size: 30rpx; line-height: 1.1; color: var(--text); }
.key .ym {
  font-size: 18rpx; line-height: 1.1; color: var(--ghost);
  max-width: 100%; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
}
.key.hover { background: #222; }
.key.pressed { transform: scale(0.94); background: #24343a; border-color: var(--accent); }
.key.pressed-a, .key.pressed-b { animation-duration: 90ms; animation-timing-function: ease-out; }
.key.pressed-a { animation-name: kbpress-a; }
.key.pressed-b { animation-name: kbpress-b; }
.key.cur { border-color: var(--accent); box-shadow: 0 0 12rpx rgba(0, 242, 255, 0.45); }
.key.cur .sm { color: var(--accent); }
.key.next { border-color: rgba(0, 242, 255, 0.35); }
.key.err { border-color: var(--err); box-shadow: 0 0 12rpx rgba(255, 23, 68, 0.5); }
.key.err-a, .key.err-b { animation-duration: 130ms; animation-timing-function: ease-out; }
.key.err-a { animation-name: kbshake-a; }
.key.err-b { animation-name: kbshake-b; }
.key.heat1 { background: rgba(196, 87, 78, 0.22); }
.key.heat2 { background: rgba(196, 87, 78, 0.5); }
.key.heat3 { background: rgba(196, 87, 78, 0.85); }
/* p-a/p-b、e-a/e-b 动画体相同，仅 animation-name 不同：切类即重启动画，连击同一键也能重播 */
@keyframes kbpress-a {
  0%, 100% { transform: translateY(0) scale(1); }
  45% { transform: translateY(2px) scale(0.94); }
}
@keyframes kbpress-b {
  0%, 100% { transform: translateY(0) scale(1); }
  45% { transform: translateY(2px) scale(0.94); }
}
@keyframes kbshake-a {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-4rpx); }
  75% { transform: translateX(4rpx); }
}
@keyframes kbshake-b {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-4rpx); }
  75% { transform: translateX(4rpx); }
}
