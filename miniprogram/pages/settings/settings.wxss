.page { padding: 24rpx 28rpx calc(48rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.sec { font-size: 26rpx; color: var(--ghost); margin: 28rpx 0 16rpx; }
.card { background: var(--surface); border: 2rpx solid var(--stroke); border-radius: 16rpx; }

.seg { display: flex; overflow: hidden; }
.segbtn {
  flex: 1; text-align: center; padding: 24rpx 0; font-size: 28rpx; color: var(--ghost);
  transition: background-color 0.15s, color 0.15s; border-right: 2rpx solid var(--stroke);
}
.segbtn:last-child { border-right: none; }
.segbtn.on { color: var(--accent); background: rgba(0, 242, 255, 0.12); font-weight: 500; }

.rows { padding: 8rpx 24rpx; }
.row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 26rpx 0; border-bottom: 2rpx solid var(--stroke); font-size: 28rpx;
  transition: opacity 0.15s, background-color 0.15s;
}
.row:last-child { border-bottom: none; }
.row-hover { opacity: 0.75; }
.row.danger { padding: 28rpx 0; }
.danger-hover { opacity: 0.75; background: rgba(255, 23, 68, 0.06); }
.row.danger text { color: var(--err); font-weight: 500; }
.arrow { color: var(--accent); font-size: 26rpx; }
.note { font-size: 22rpx; color: var(--ghost); margin-top: 12rpx; line-height: 1.4; }

switch {
  transform: scale(0.84);
  transform-origin: right center;
}
