/* 练习页：Obsidian Focus 令牌 + 设计稿版式 */
.page { min-height: 100vh; display: flex; flex-direction: column; padding: 16rpx 24rpx 0; }

.modes { white-space: nowrap; margin-bottom: 16rpx; }
.modeinner { display: inline-flex; gap: 12rpx; padding: 4rpx 0; }
.chip {
  display: inline-block; padding: 10rpx 24rpx;
  background: var(--surface); border: 2rpx solid var(--stroke); border-radius: 32rpx;
  font-size: 26rpx; color: var(--text);
}
.chip.on { border-color: var(--accent); color: var(--accent); box-shadow: 0 0 10rpx rgba(0, 242, 255, 0.25); }

.metrics { display: flex; gap: 28rpx; justify-content: center; margin-bottom: 24rpx; }
.metrics .m { font-size: 30rpx; }
.metrics .unit { font-size: 20rpx; color: var(--ghost); margin-left: 4rpx; }

.wordrow { display: flex; justify-content: center; gap: 16rpx; margin: 24rpx 0 12rpx; }
.slot {
  font-size: 76rpx; width: 104rpx; height: 104rpx; line-height: 104rpx; text-align: center;
  background: var(--surface); border: 2rpx solid var(--stroke); border-radius: 16rpx;
}
.slot.done { color: var(--ok); border-color: rgba(0, 230, 118, 0.4); }
.slot.cur { color: var(--accent); border-color: var(--accent); box-shadow: 0 0 14rpx rgba(0, 242, 255, 0.35); }
.slot.wait { color: var(--ghost); }

.hintrow { text-align: center; color: var(--ghost); font-size: 28rpx; min-height: 40rpx; }
.hintrow .code { color: var(--text); margin-left: 12rpx; }

.coderow { display: flex; justify-content: center; gap: 12rpx; margin: 16rpx 0; }
.chip-code {
  width: 56rpx; height: 56rpx; line-height: 56rpx; text-align: center;
  border: 2rpx solid var(--stroke); border-radius: 8rpx; font-size: 30rpx; color: var(--ghost);
}
.chip-code.done { color: var(--ok); border-color: rgba(0, 230, 118, 0.4); }
.chip-code.cur { color: var(--accent); border-color: var(--accent); }

.fb { text-align: center; min-height: 40rpx; font-size: 26rpx; color: var(--err); }
.steps { text-align: center; font-size: 24rpx; color: var(--ghost); margin: 8rpx 0; }
.steps .g1 { color: var(--accent); }
.steps .g2 { color: var(--ok); }

.prog { height: 6rpx; background: var(--stroke); border-radius: 3rpx; margin: 20rpx 0 8rpx; overflow: hidden; }
.prog .bar { height: 100%; background: var(--accent); transition: width 200ms; }
.doneinfo { text-align: center; font-size: 22rpx; color: var(--ghost); margin-bottom: 16rpx; }

.empty { text-align: center; padding: 96rpx 32rpx; }
.empty .symbol { display: block; font-size: 80rpx; color: var(--ghost); }
.empty .guide { display: block; margin-top: 24rpx; color: var(--ghost); font-size: 28rpx; }

.result { padding: 40rpx 32rpx; margin: 40rpx 0; }
.resgrid { display: flex; justify-content: space-around; margin-bottom: 32rpx; }
.resgrid view { display: flex; flex-direction: column; align-items: center; }
.resgrid .b { font-size: 48rpx; color: var(--accent); }
.resgrid .t { font-size: 24rpx; color: var(--ghost); margin-top: 8rpx; }
.resbtns { display: flex; gap: 24rpx; justify-content: center; }
.resbtns .btn { padding: 16rpx 24rpx; }
.reshome { text-align: center; color: var(--ghost); font-size: 24rpx; margin-top: 24rpx; }

.btn {
  font-size: 28rpx; padding: 16rpx 40rpx; border-radius: 12rpx;
  background: var(--surface); color: var(--text); border: 2rpx solid var(--stroke);
}
.btn.primary { background: rgba(0, 242, 255, 0.12); border-color: var(--accent); color: var(--accent); }

.fnrow {
  display: flex; gap: 12rpx; justify-content: center;
  padding: 16rpx 0 calc(16rpx + env(safe-area-inset-bottom));
}
.fnbtn {
  padding: 12rpx 28rpx; font-size: 24rpx; color: var(--ghost);
  background: var(--surface); border: 2rpx solid var(--stroke); border-radius: 10rpx;
}
.fnbtn.on { color: var(--accent); border-color: rgba(0, 242, 255, 0.4); }

.sysinput { position: fixed; left: -9999rpx; top: 0; opacity: 0; }
.postercanvas { position: fixed; left: -9999px; top: 0; width: 900px; height: 500px; }
