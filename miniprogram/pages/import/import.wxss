.page { padding: 24rpx 28rpx calc(48rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.sec { font-size: 26rpx; color: var(--ghost); margin: 28rpx 0 16rpx; }
.card { background: var(--surface); border: 2rpx solid var(--stroke); border-radius: 16rpx; }

.drop {
  padding: 40rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  border-style: dashed;
  border-color: rgba(0, 242, 255, 0.35);
  background: rgba(0, 242, 255, 0.02);
  transition: background-color 0.15s, border-color 0.15s;
}
.drop-hover {
  background: rgba(0, 242, 255, 0.08);
  border-color: var(--accent);
}
.d1 { font-size: 28rpx; color: var(--accent); font-weight: 500; }
.d2 { font-size: 22rpx; color: var(--ghost); text-align: center; }

.report { margin-top: 16rpx; display: flex; flex-direction: column; gap: 8rpx; }
.line { font-size: 24rpx; color: var(--text); line-height: 1.5; }
.line.bad { color: var(--err); }
.line.note { color: var(--ghost); }
.fname { font-weight: 600; }

.lib {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 14rpx;
  gap: 16rpx;
}
.info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.lname {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.lsub {
  font-size: 22rpx;
  color: var(--ghost);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.lib .btn {
  flex-shrink: 0;
  min-width: 156rpx;
  height: 74rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: 12rpx;
}

.btn {
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  border-radius: 12rpx;
  background: var(--surface);
  color: var(--text);
  border: 2rpx solid var(--stroke);
  transition: opacity 0.15s, background-color 0.15s, border-color 0.15s;
}
.btn.primary {
  background: rgba(0, 242, 255, 0.12);
  border-color: var(--accent);
  color: var(--accent);
}
.btn.ghost { color: var(--ghost); }
.btn.ghost.danger { color: var(--err); border-color: rgba(255, 23, 68, 0.25); }
.btn[disabled] {
  color: rgba(255, 255, 255, 0.35) !important;
  background: rgba(255, 255, 255, 0.03) !important;
  border-color: rgba(255, 255, 255, 0.08) !important;
  opacity: 1 !important;
}

.custom {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.custom textarea, .custom-input {
  width: 100%;
  height: 200rpx;
  max-height: 280rpx;
  font-size: 28rpx;
  color: var(--text);
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 10rpx;
  padding: 16rpx;
  box-sizing: border-box;
  line-height: 1.6;
}
.ph-style {
  color: var(--ghost);
}
.custom-btn {
  width: 100%;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 12rpx;
}

.empty { color: var(--ghost); font-size: 26rpx; padding: 16rpx 0; }
