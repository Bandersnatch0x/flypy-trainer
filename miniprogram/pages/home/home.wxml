<view class="page">
  <view class="head">
    <view class="brand">
      <text class="wordmark">鹤练</text>
      <text class="en mono">FLYPY TRAINER</text>
    </view>
    <view class="headright" bindtap="goSchemes">
      <text class="chip accent">{{schemeName}}</text>
      <text wx:if="{{streak}}" class="chip">连练 {{streak}} 天</text>
    </view>
  </view>

  <view class="cards">
    <view class="card ov"><text class="b mono">{{pbKpm}}</text><text class="t">PB 键/分 · {{schemeName}}</text></view>
    <view class="card ov"><text class="b mono">{{streak}}</text><text class="t">连练天数</text></view>
    <view class="card ov"><text class="b mono">{{mistakes}}</text><text class="t">错词待练</text></view>
  </view>

  <view class="sec">开练</view>
  <view class="grid">
    <view wx:for="{{modes}}" wx:key="mode" class="card mcard" data-mode="{{item.mode}}" bindtap="go">
      <text class="mlabel">{{item.label}}</text>
      <text class="mdesc">{{item.desc}}</text>
    </view>
  </view>

  <view wx:if="{{!isShape && confus.length}}" class="sec">易混对抗</view>
  <view wx:if="{{!isShape && confus.length}}" class="confusrow">
    <view wx:for="{{confus}}" wx:key="i" class="chip confus" data-i="{{item.i}}" bindtap="goConfus">{{item.label}}</view>
  </view>

  <view class="sec">词表集市</view>
  <view class="card market" bindtap="goImport">
    <view>
      <text class="mlabel">编程术语 · 常用成语</text>
      <text class="mdesc">一键订阅，或导入你自己的词库</text>
    </view>
    <text class="arrow">→</text>
  </view>
</view>
