.page { padding: 32rpx 28rpx calc(48rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.head { display: flex; flex-direction: column; margin-bottom: 32rpx; }
.wordmark { font-size: 56rpx; font-weight: 700; }
.sub { font-size: 24rpx; color: var(--ghost); margin-top: 8rpx; }

.btn {
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 14rpx;
  background: var(--surface);
  color: var(--text);
  border: 2rpx solid var(--stroke);
  transition: opacity 0.15s, transform 0.15s, background-color 0.15s, border-color 0.15s;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn.primary {
  background: rgba(0, 242, 255, 0.12);
  border-color: var(--accent);
  color: var(--accent);
  box-shadow: 0 0 16rpx rgba(0, 242, 255, 0.15);
}
.btn.big {
  width: 100%;
  height: 88rpx;
  margin-bottom: 32rpx;
  font-size: 30rpx;
}
.btn.share {
  width: 100%;
  height: 88rpx;
  margin-top: 28rpx;
  background: rgba(255, 255, 255, 0.04);
}

.card { background: var(--surface); border: 2rpx solid var(--stroke); border-radius: 16rpx; }
.rows { padding: 8rpx 24rpx; }
.row {
  display: flex; justify-content: space-between; align-items: center;
  padding: 28rpx 0; border-bottom: 2rpx solid var(--stroke); font-size: 28rpx;
  transition: opacity 0.15s;
}
.row:last-child { border-bottom: none; }
.val { color: var(--ghost); font-size: 26rpx; }

.row-hover {
  opacity: 0.75;
}
.btn-hover {
  opacity: 0.85;
  transform: scale(0.99);
}

.about { margin-top: 32rpx; padding: 28rpx 24rpx; }
.aline { font-size: 24rpx; color: var(--ghost); line-height: 1.8; }
