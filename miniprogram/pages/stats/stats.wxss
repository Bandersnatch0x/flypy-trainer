.page { padding: 24rpx 28rpx 48rpx; }
.sec { font-size: 26rpx; color: var(--ghost); margin: 32rpx 0 16rpx; }
.card { background: var(--surface); border: 2rpx solid var(--stroke); border-radius: 16rpx; }
.mono { font-family: "JetBrains Mono", Menlo, Consolas, monospace; }
.ok { color: var(--ok); }

.cards { display: flex; gap: 12rpx; flex-wrap: wrap; }
.ov { flex: 1; min-width: 150rpx; padding: 24rpx 12rpx; display: flex; flex-direction: column; align-items: center; }
.ov .b { font-size: 40rpx; color: var(--accent); }
.ov .t { font-size: 20rpx; color: var(--ghost); margin-top: 8rpx; text-align: center; }

.badges { display: flex; flex-wrap: wrap; gap: 12rpx; }
.badge {
  flex: 1 0 28%; display: flex; flex-direction: column; align-items: center; padding: 20rpx 8rpx;
  background: var(--surface); border: 2rpx solid var(--stroke); border-radius: 12rpx; opacity: 0.45;
}
.badge.got { opacity: 1; border-color: rgba(0, 242, 255, 0.45); }
.badge .bname { font-size: 26rpx; }
.badge.got .bname { color: var(--accent); }
.badge .bdesc { font-size: 20rpx; color: var(--ghost); margin-top: 6rpx; }

.calwrap { padding: 20rpx; }
.cal { display: flex; flex-wrap: wrap; gap: 4rpx; }
.cal .cell { width: 12rpx; height: 12rpx; border-radius: 2rpx; background: var(--stroke); }
.cal .lv1 { background: rgba(0, 242, 255, 0.25); }
.cal .lv2 { background: rgba(0, 242, 255, 0.55); }
.cal .lv3 { background: var(--accent); }

.heatwrap { padding: 12rpx; }
.heattop { display: flex; flex-wrap: wrap; gap: 12rpx; justify-content: center; padding: 12rpx 0; }
.hk { font-size: 22rpx; color: var(--err); padding: 4rpx 16rpx; border: 2rpx solid rgba(255, 23, 68, 0.35); border-radius: 20rpx; }

.sparkwrap { padding: 24rpx; }
.no { color: var(--ghost); font-size: 24rpx; text-align: center; }
.spark { display: flex; align-items: flex-end; gap: 6rpx; height: 100rpx; }
.spark .bar { flex: 1; min-height: 4rpx; background: rgba(0, 242, 255, 0.45); border-radius: 2rpx 2rpx 0 0; }
.spark .bar.good { background: var(--ok); }

.sesslist { padding: 8rpx 24rpx; }
.sess {
  display: flex; flex-wrap: wrap; gap: 8rpx 20rpx; align-items: center;
  padding: 20rpx 0; border-bottom: 2rpx solid var(--stroke); font-size: 24rpx;
}
.sess:last-child { border-bottom: none; }
.stime { color: var(--ghost); }
.smode { color: var(--text); }
.sacc { color: var(--accent); margin-left: auto; }
