.page {
  padding: 24rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  min-height: 100vh;
}

/* 顶部操作区 */
.actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  font-size: 26rpx;
  font-weight: 500;
  padding: 0 12rpx;
  border-radius: 14rpx;
  background: var(--surface);
  color: var(--text);
  border: 2rpx solid var(--stroke);
  transition: opacity 0.15s, background-color 0.15s, border-color 0.15s;
  white-space: nowrap;
}

.btn.primary {
  background: rgba(0, 242, 255, 0.12);
  border-color: var(--accent);
  color: var(--accent);
  box-shadow: 0 0 12rpx rgba(0, 242, 255, 0.15);
}

.btn.ghost {
  background: var(--surface);
  color: var(--text);
}

.btn.danger {
  color: rgba(255, 255, 255, 0.85);
  border-color: var(--stroke);
}

.btn.danger:not([disabled]):active {
  color: var(--err);
  border-color: rgba(255, 23, 68, 0.5);
}

.btn[disabled] {
  color: rgba(255, 255, 255, 0.35) !important;
  background: rgba(255, 255, 255, 0.03) !important;
  border-color: rgba(255, 255, 255, 0.1) !important;
  box-shadow: none !important;
  opacity: 1 !important;
}

/* 提示条 */
.note-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 20rpx;
  background: rgba(255, 255, 255, 0.03);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 12rpx;
  margin-bottom: 32rpx;
}

.note-icon {
  font-size: 24rpx;
  color: var(--accent);
  opacity: 0.8;
  line-height: 1;
}

.note-txt {
  font-size: 22rpx;
  color: var(--ghost);
  line-height: 1.4;
}

/* 空状态 */
.emptywrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx 80rpx;
  text-align: center;
}

.empty-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(0, 242, 255, 0.06);
  border: 2rpx solid rgba(0, 242, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  box-shadow: 0 0 24rpx rgba(0, 242, 255, 0.08);
}

.empty-icon-inner {
  font-size: 52rpx;
  color: var(--accent);
  line-height: 1;
  font-weight: bold;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: var(--ghost);
  line-height: 1.5;
  max-width: 480rpx;
  margin-bottom: 48rpx;
}

.empty-btn {
  flex: none;
  width: 280rpx;
  height: 80rpx;
  font-size: 28rpx;
  font-weight: 600;
  background: var(--accent) !important;
  color: #0b0f14 !important;
  border: none !important;
  box-shadow: 0 0 24rpx rgba(0, 242, 255, 0.35) !important;
}

/* 列表展示 */
.list-wrap {
  margin-top: 8rpx;
}

.list-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 8rpx 16rpx;
}

.list-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}

.list-badge {
  font-size: 22rpx;
  color: var(--ghost);
}

.card {
  background: var(--surface);
  border: 2rpx solid var(--stroke);
  border-radius: 16rpx;
}

.mklist {
  padding: 0 24rpx;
}

.mk {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--stroke);
}

.mk:last-child {
  border-bottom: none;
}

.mk-left {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
}

.mk .w {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text);
}

.mk .c {
  font-size: 26rpx;
  color: var(--accent);
  letter-spacing: 1rpx;
}

.tag {
  font-size: 22rpx;
  color: var(--err);
  background: rgba(255, 23, 68, 0.1);
  border: 1rpx solid rgba(255, 23, 68, 0.25);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.mono {
  font-family: "JetBrains Mono", Menlo, Consolas, monospace;
}
