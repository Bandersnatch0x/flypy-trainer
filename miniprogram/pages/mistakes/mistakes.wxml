<view class="page">
  <!-- 顶部操作栏 -->
  <view class="actions">
    <button class="btn primary" bindtap="train" disabled="{{empty}}">开始强化</button>
    <button class="btn ghost" bindtap="exportRime" disabled="{{empty}}">导出短语</button>
    <button class="btn ghost danger" bindtap="clear" disabled="{{empty}}">清空</button>
  </view>

  <!-- 方案说明提示条 -->
  <view class="note-bar">
    <text class="note-icon">ℹ</text>
    <text class="note-txt">错词按「{{schemeName}}」记账；展示码随当前方案重派</text>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{empty}}" class="emptywrap">
    <view class="empty-icon-wrap">
      <view class="empty-icon-inner">✓</view>
    </view>
    <view class="empty-title">还没有错词记录</view>
    <view class="empty-sub">练习中产生的错词会自动收录于此，随时可专项强化</view>
    <button class="btn primary empty-btn" bindtap="goPractice">去练习</button>
  </view>

  <!-- 错词列表 -->
  <view wx:else class="list-wrap">
    <view class="list-head">
      <text class="list-title">错词列表</text>
      <text class="list-badge">共 {{count}} 词</text>
    </view>
    <view class="card mklist">
      <view wx:for="{{list}}" wx:key="word" class="mk">
        <view class="mk-left">
          <text class="w">{{item.word}}</text>
          <text class="c mono">{{item.shown}}</text>
        </view>
        <view class="mk-right">
          <text class="tag">错 {{item.n}} 次</text>
        </view>
      </view>
    </view>
  </view>
</view>
