<view class="page">
  <view class="actions">
    <button class="btn primary" bindtap="train" disabled="{{empty}}">开始强化</button>
    <button class="btn" bindtap="exportRime" disabled="{{empty}}">导出输入法短语</button>
    <button class="btn ghost" bindtap="clear" disabled="{{empty}}">清空</button>
  </view>
  <view class="note">错词按「{{schemeName}}」记账；展示码随当前方案重派。</view>

  <view wx:if="{{empty}}" class="emptywrap">
    <view class="big">∅</view>
    <view>还没有错过，继续</view>
    <view class="sub">词库全方案通用，立即可练</view>
  </view>

  <view wx:else class="card mklist">
    <view wx:for="{{list}}" wx:key="word" class="mk">
      <text class="w">{{item.word}}</text>
      <text class="c mono">{{item.shown}}</text>
      <text class="n">错 {{item.n}} 次</text>
    </view>
  </view>
</view>
