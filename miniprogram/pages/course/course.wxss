.page { padding: 24rpx 28rpx 48rpx; }

.stages { display: flex; flex-direction: column; gap: 12rpx; margin-bottom: 24rpx; }
.stage {
  display: flex; align-items: center; gap: 20rpx; padding: 20rpx 24rpx;
  background: var(--surface); border: 2rpx solid var(--stroke); border-radius: 12rpx;
}
.stage.on { border-color: var(--accent); box-shadow: 0 0 10rpx rgba(0, 242, 255, 0.2); }
.stage .sn { width: 44rpx; text-align: center; color: var(--ghost); font-size: 28rpx; }
.stage.done .sn { color: var(--ok); }
.stage.on .sn { color: var(--accent); }
.st { display: flex; flex-direction: column; }
.sname { font-size: 28rpx; }
.ssub { font-size: 22rpx; color: var(--ghost); margin-top: 4rpx; }

.card { background: var(--surface); border: 2rpx solid var(--stroke); border-radius: 16rpx; }
.chal { padding: 28rpx 24rpx; margin-bottom: 24rpx; display: flex; flex-direction: column; gap: 12rpx; }
.cname { font-size: 30rpx; }
.csub { font-size: 24rpx; color: var(--ghost); margin: 8rpx 0; }
.days { display: flex; gap: 12rpx; }
.day {
  width: 56rpx; height: 56rpx; line-height: 56rpx; text-align: center;
  border: 2rpx solid var(--stroke); border-radius: 8rpx; font-size: 22rpx; color: var(--ghost);
}
.day.done { color: var(--ok); border-color: rgba(0, 230, 118, 0.5); }

.body { padding: 32rpx 24rpx; }
.bname { font-size: 34rpx; font-weight: 600; margin-bottom: 16rpx; }
.btext { font-size: 26rpx; color: rgba(255, 255, 255, 0.72); line-height: 1.7; margin-bottom: 24rpx; }

.btn {
  font-size: 28rpx; padding: 16rpx 40rpx; border-radius: 12rpx; margin: 8rpx 0;
  background: var(--surface); color: var(--text); border: 2rpx solid var(--stroke);
}
.btn.primary { background: rgba(0, 242, 255, 0.12); border-color: var(--accent); color: var(--accent); }
.btn[disabled] { color: var(--ghost); border-color: var(--stroke); background: var(--surface); }

.dgroup { margin-top: 24rpx; }
.dlabel { font-size: 26rpx; margin-bottom: 12rpx; }
.dkeys { display: flex; flex-wrap: wrap; gap: 12rpx; }
.dkey {
  position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center;
  min-width: 88rpx; padding: 12rpx 16rpx;
  background: var(--bg); border: 2rpx solid var(--stroke); border-radius: 8rpx;
}
.dkey .dm { font-size: 28rpx; }
.dkey .ds { font-size: 18rpx; color: var(--ghost); }
.dkey .due { position: absolute; top: 2rpx; right: 6rpx; font-size: 16rpx; color: var(--accent); }

.legend { text-align: center; font-size: 22rpx; color: var(--ghost); margin: 12rpx 0; }
.detail {
  white-space: pre-wrap; margin-top: 24rpx; padding: 20rpx;
  background: var(--bg); border: 2rpx solid var(--stroke); border-radius: 8rpx;
  font-size: 26rpx; line-height: 1.7;
}
.formnote { font-size: 22rpx; color: var(--ghost); margin: 20rpx 0; }

.empty { text-align: center; padding: 96rpx 32rpx; }
.empty .guide { display: block; color: var(--ghost); margin-bottom: 24rpx; }
