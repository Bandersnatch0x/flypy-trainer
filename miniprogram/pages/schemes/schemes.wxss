.page { padding: 24rpx 28rpx 48rpx; }
.head { margin-bottom: 24rpx; }
.title { font-size: 44rpx; font-weight: 700; }
.sub { font-size: 24rpx; color: var(--ghost); margin-top: 8rpx; }

.card { background: var(--surface); border: 2rpx solid var(--stroke); border-radius: 16rpx; }
.scard { padding: 28rpx 24rpx; margin-bottom: 16rpx; }
.scard.flagship { border-color: rgba(0, 242, 255, 0.35); }
.scard.degraded { opacity: 0.8; }
.top { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx; margin-bottom: 12rpx; }
.flagbadge { font-size: 20rpx; color: var(--accent); border: 2rpx solid rgba(0, 242, 255, 0.4); border-radius: 20rpx; padding: 2rpx 14rpx; }
.sname { font-size: 32rpx; font-weight: 600; }
.paratag { font-size: 20rpx; color: var(--ghost); border: 2rpx solid var(--stroke); border-radius: 20rpx; padding: 2rpx 14rpx; }
.feat { font-size: 26rpx; color: rgba(255, 255, 255, 0.78); line-height: 1.6; }
.progress { font-size: 24rpx; color: var(--accent); margin-top: 12rpx; }
.state { display: flex; flex-wrap: wrap; gap: 12rpx; align-items: center; margin-top: 16rpx; font-size: 22rpx; }
.formtag { color: var(--ghost); border: 2rpx solid var(--stroke); border-radius: 20rpx; padding: 2rpx 14rpx; }
.formtag.gray { color: var(--ghost); }
.datastate { color: var(--ok); }
.sum { color: var(--ghost); }
.inuse { margin-top: 16rpx; color: var(--ok); font-size: 26rpx; }

.btn { font-size: 28rpx; padding: 14rpx 36rpx; border-radius: 12rpx; margin-top: 20rpx; background: var(--surface); color: var(--text); border: 2rpx solid var(--stroke); }
.btn.primary { background: rgba(0, 242, 255, 0.12); border-color: var(--accent); color: var(--accent); }
.btn.ghost { color: var(--ghost); }

.group { margin-top: 32rpx; }
.gtitle { font-size: 30rpx; margin-bottom: 16rpx; }
.gblurb { font-size: 22rpx; color: var(--ghost); margin-left: 16rpx; }
